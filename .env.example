# ==============================================================================
# Raymarkable Environment Variables Configuration Template
# Duplicate this file to .env or .env.local and fill in your values.
# ==============================================================================

# Database Connection URL (Supabase Postgres Transaction Pooler or Direct connection)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres"

# Supabase Auth & Storage API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Native Web Push Notifications (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:support@raymarkable.com"

# Cron Secret for automated maintenance tasks (e.g. /api/cron/cleanup-teams)
CRON_SECRET="your-secure-cron-secret-token"
